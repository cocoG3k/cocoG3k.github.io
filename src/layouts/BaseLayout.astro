---
import "../styles/global.css";
const { title = "cocoG学入門", description = "日記と、聴いた曲の記録。真髄はここに。", active = "diary", total } = Astro.props;
// The homepage is an alternate entry point to the same article index.
const canonicalPath = Astro.url.pathname === "/" ? "/diary" : Astro.url.pathname.replace(/\/$/, "");
const canonical = new URL(canonicalPath || "/", Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="cocoG学入門" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <div class="page">
      <header class="site-header">
        <p class="site-name"><a href="/">cocoG学入門</a></p>
        <p class="tagline">真髄はここに</p>
      </header>
      <nav class="site-nav" aria-label="メインナビゲーション">
        <a href="/diary" aria-current={active === "diary" ? "page" : undefined}>記事一覧</a>
        <a href="/about" aria-current={active === "about" ? "page" : undefined}>このブログについて</a>
        <a href="https://github.com/cocoG3k">GitHub</a>
      </nav>
      <slot />
      <footer class="site-footer"><span>© cocoG学入門</span>{total !== undefined && <span>全{total}記事</span>}</footer>
    </div>
  </body>
</html>
